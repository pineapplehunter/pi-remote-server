{
  "name": "pi-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./extensions/pi-remote/index.ts"] },
  "scripts": {
    "test": "node --experimental-transform-types --test tests/*.test.ts",
